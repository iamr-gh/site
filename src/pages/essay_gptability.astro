---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Essay GPT-ability Analyzer | iamr">
  
  <main class="min-h-screen bg-background">
    <section class="container px-4 py-8">
      <div class="max-w-3xl mx-auto space-y-6">
        <!-- Hero Section -->
        <div class="text-center space-y-4">
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-light tracking-tight text-foreground font-serif animate-fade-in">
            Essay Prompt GPT-ability Analyzer
          </h1>
          <p class="text-lg md:text-xl text-muted-foreground font-light animate-slide-up-delayed">
            Predict how well LLMs can imitate human writing for a given prompt
          </p>
        </div>

        <!-- Status Bar -->
        <div class="flex items-center gap-2 px-4 py-3 bg-muted/50 rounded-lg border border-border">
          <div class="w-2 h-2 rounded-full bg-warning animate-pulse" id="statusDot"></div>
          <span class="text-sm text-foreground" id="statusText">Loading models...</span>
        </div>

        <!-- Sample Prompts Card -->
        <div class="bg-card border border-border rounded-lg p-6 shadow-sm">
          <h2 class="text-lg font-medium text-foreground mb-4">Sample Prompts</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="samplePrompts">
            <!-- GPT-able prompts -->
            <button class="sample-prompt text-left p-3 bg-muted/50 border border-transparent hover:border-destructive/50 rounded-md transition-all duration-200 group relative overflow-hidden" data-prompt="[CW] Write a scene between 2 or more characters using only dialogue. No narration, no action lines, just dialogue.">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-destructive"></div>
              <div class="text-xs font-medium text-destructive uppercase tracking-wider mb-1">Most GPT-able</div>
              <div class="text-sm text-muted-foreground line-clamp-2 group-hover:text-foreground transition-colors">
                [CW] Write a scene between 2 or more characters using only dialogue...
              </div>
            </button>

            <button class="sample-prompt text-left p-3 bg-muted/50 border border-transparent hover:border-destructive/50 rounded-md transition-all duration-200 group relative overflow-hidden" data-prompt="[WP] He sighed.">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-destructive"></div>
              <div class="text-xs font-medium text-destructive uppercase tracking-wider mb-1">Most GPT-able</div>
              <div class="text-sm text-muted-foreground line-clamp-2 group-hover:text-foreground transition-colors">
                [WP] He sighed.
              </div>
            </button>

            <button class="sample-prompt text-left p-3 bg-muted/50 border border-transparent hover:border-destructive/50 rounded-md transition-all duration-200 group relative overflow-hidden" data-prompt="[WP] She was almost beautiful.">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-destructive"></div>
              <div class="text-xs font-medium text-destructive uppercase tracking-wider mb-1">Most GPT-able</div>
              <div class="text-sm text-muted-foreground line-clamp-2 group-hover:text-foreground transition-colors">
                [WP] She was almost beautiful.
              </div>
            </button>

            <!-- Mixed prompt -->
            <button class="sample-prompt text-left p-3 bg-muted/50 border border-transparent hover:border-warning/50 rounded-md transition-all duration-200 group relative overflow-hidden" data-prompt="[WP] Write about a character who discovers they have an unusual superpower that seems useless at first.">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-warning"></div>
              <div class="text-xs font-medium text-warning uppercase tracking-wider mb-1">Mixed</div>
              <div class="text-sm text-muted-foreground line-clamp-2 group-hover:text-foreground transition-colors">
                [WP] Write about a character who discovers they have an unusual superpower...
              </div>
            </button>

            <!-- Human-distinctive prompts -->
            <button class="sample-prompt text-left p-3 bg-muted/50 border border-transparent hover:border-success/50 rounded-md transition-all duration-200 group relative overflow-hidden md:col-span-2" data-prompt="[WP] On the planet you live on, memories can only be fully remembered once. But because of this, when you replay the memory, its as if you are right back in it. The touches, the smells, the emotions - everything is real again for those few moments.">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-success"></div>
              <div class="text-xs font-medium text-success uppercase tracking-wider mb-1">Human-Distinctive</div>
              <div class="text-sm text-muted-foreground line-clamp-2 group-hover:text-foreground transition-colors">
                [WP] On the planet you live on, memories can only be fully remembered once...
              </div>
            </button>

            <button class="sample-prompt text-left p-3 bg-muted/50 border border-transparent hover:border-success/50 rounded-md transition-all duration-200 group relative overflow-hidden md:col-span-2" data-prompt="[WP] You die. As you regain consciousness, you realize that you are in heaven. However, your expectations of a utopia are quickly ruined when you see that all posts have been abandoned, and a war has broken out.">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-success"></div>
              <div class="text-xs font-medium text-success uppercase tracking-wider mb-1">Human-Distinctive</div>
              <div class="text-sm text-muted-foreground line-clamp-2 group-hover:text-foreground transition-colors">
                [WP] You die. As you regain consciousness, you realize that you are in heaven...
              </div>
            </button>

            <button class="sample-prompt text-left p-3 bg-muted/50 border border-transparent hover:border-success/50 rounded-md transition-all duration-200 group relative overflow-hidden md:col-span-2" data-prompt="[WP] The afterlife is not based on how you live, but how you die. The more horrific and painful the death, the better the heaven. Conversely, the happier you are when you die, the deeper into hell you go.">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-success"></div>
              <div class="text-xs font-medium text-success uppercase tracking-wider mb-1">Human-Distinctive</div>
              <div class="text-sm text-muted-foreground line-clamp-2 group-hover:text-foreground transition-colors">
                [WP] The afterlife is not based on how you live, but how you die...
              </div>
            </button>

            <button class="sample-prompt text-left p-3 bg-muted/50 border border-transparent hover:border-success/50 rounded-md transition-all duration-200 group relative overflow-hidden md:col-span-2" data-prompt="You are a Marine in Vietnam, the year is 1967. While out on a patrol in the Central Highlands, your platoon stumbles upon an old abandoned Catholic church that seems to have been built during French colonial rule.">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-success"></div>
              <div class="text-xs font-medium text-success uppercase tracking-wider mb-1">Human-Distinctive</div>
              <div class="text-sm text-muted-foreground line-clamp-2 group-hover:text-foreground transition-colors">
                You are a Marine in Vietnam, the year is 1967. While out on a patrol...
              </div>
            </button>
          </div>
        </div>

        <!-- Input Card -->
        <div class="bg-card border border-border rounded-lg p-6 shadow-sm">
          <h2 class="text-lg font-medium text-foreground mb-4">Enter Your Prompt</h2>
          <textarea 
            id="promptInput" 
            placeholder="Enter an essay or creative writing prompt to analyze its GPT-ability..."
            class="w-full min-h-[150px] bg-muted/50 border border-input rounded-lg p-4 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-all duration-200 resize-y"
          ></textarea>
          <div class="flex flex-wrap gap-3 mt-4">
            <button 
              id="analyzeBtn" 
              disabled
              class="inline-flex items-center justify-center whitespace-nowrap rounded-lg text-sm font-light ring-offset-background transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 px-6 py-3"
            >
              Analyze Prompt
            </button>
            <button 
              id="clearBtn" 
              class="inline-flex items-center justify-center whitespace-nowrap rounded-lg text-sm font-light ring-offset-background transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground px-6 py-3"
            >
              Clear
            </button>
          </div>
        </div>

        <!-- Result Card -->
        <div class="bg-card border border-border rounded-lg p-6 shadow-sm result-container" id="resultContainer">
          <h2 class="text-lg font-medium text-foreground mb-6">Analysis Result</h2>
          
          <div class="text-center py-6">
            <div class="text-5xl font-bold mb-2" id="scoreValue">--</div>
            <div class="text-xl font-medium mb-4" id="scoreLabel">--</div>
            
            <!-- Score Bar -->
            <div class="h-3 bg-muted/50 rounded-full overflow-hidden mx-auto mb-2 max-w-md">
              <div class="h-full rounded-full transition-all duration-500 ease-out w-0" id="scoreBarFill"></div>
            </div>
            <div class="flex justify-between text-xs text-muted-foreground max-w-md mx-auto mb-6">
              <span>0.2 (Human-Distinctive)</span>
              <span>0.6 (GPT-able)</span>
            </div>
            
            <!-- Interpretation -->
            <div class="bg-muted/50 rounded-lg p-4 text-left text-sm leading-relaxed text-foreground/90" id="interpretation">
            </div>
          </div>
        </div>

        <!-- Footer -->
        <footer class="text-center pt-6 border-t border-border">
          <p class="text-sm text-muted-foreground mb-2">
            Based on research by Ibrahim Musaddequr Rahman | 
            <a href="https://github.com/iamr-gh/essay-gptability" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">GitHub</a>,
            <a href="https://github.com/iamr-gh/essay-gptability/blob/main/paper.pdf" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Paper</a>
          </p>
          <p class="text-xs text-muted-foreground">
            Model: all-MiniLM-L12-v2 + Custom Regression Head | Runs entirely in your browser using WebAssembly
          </p>
        </footer>
      </div>
    </section>

    <!-- Loading Overlay -->
    <div class="fixed inset-0 bg-background/95 z-50 flex items-center justify-center flex-col hidden" id="loadingOverlay">
      <div class="w-12 h-12 border-3 border-muted border-t-primary rounded-full animate-spin"></div>
      <div class="mt-4 text-foreground" id="loadingText">Loading models...</div>
      <div class="w-64 h-1.5 bg-muted rounded-full mt-4 overflow-hidden">
        <div class="h-full bg-primary rounded-full transition-all duration-300 w-0" id="progressBar"></div>
      </div>
    </div>
  </main>

  <!-- Load our inference module (includes ONNX Runtime) -->
  <script type="module" src="/inference.js"></script>

  <style>
    .bg-warning {
      background-color: hsl(38, 92%, 50%);
    }
    
    .bg-success {
      background-color: hsl(153, 53%, 53%);
    }
    
    .bg-destructive {
      background-color: hsl(0, 84.2%, 60.2%);
    }
    
    .text-warning {
      color: hsl(38, 92%, 50%);
    }
    
    .text-success {
      color: hsl(153, 53%, 53%);
    }
    
    .text-destructive {
      color: hsl(0, 84.2%, 60.2%);
    }
    
    .border-warning\/50 {
      border-color: hsla(38, 92%, 50%, 0.5);
    }
    
    .border-success\/50 {
      border-color: hsla(153, 53%, 53%, 0.5);
    }
    
    .border-destructive\/50 {
      border-color: hsla(0, 84.2%, 60.2%, 0.5);
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .result-container {
      display: none;
    }

    .result-container.visible {
      display: block;
    }
  </style>
</Layout>
