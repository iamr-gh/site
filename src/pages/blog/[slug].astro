---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import { extractHeadingsFromMarkdown } from '../../lib/utils';
import { Menu, X } from 'lucide-react';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  // Sort by publication date (newest first)
  const sortedEntries = blogEntries.sort((a: any, b: any) => 
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );
  
  return sortedEntries.map((entry: any, index: number) => ({
    params: { slug: entry.slug }, 
    props: { 
      entry,
      previousEntry: index < sortedEntries.length - 1 ? sortedEntries[index + 1] : null,
      nextEntry: index > 0 ? sortedEntries[index - 1] : null,
    },
  }));
}

const { entry, previousEntry, nextEntry }: { 
  entry: CollectionEntry<'blog'>, 
  previousEntry: CollectionEntry<'blog'> | null,
  nextEntry: CollectionEntry<'blog'> | null 
} = Astro.props;

// Extract headings for TOC from raw markdown content
const headings = extractHeadingsFromMarkdown(entry.body || '');

// Render content
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | iamr`}>
  <Header sticky />
  
  <!-- Reading Progress Bar -->
  <div class="reading-progress" id="reading-progress"></div>
  
  <main class="py-8">
    
    {headings.length > 3 && (
      
      <div id="mobile-toc-container">
        <!-- Mobile TOC Toggle Button -->
        <button 
          id="toc-toggle"
          class="lg:hidden fixed top-24 left-4 z-50 inline-flex items-center justify-center rounded-lg p-2 bg-background border border-border hover:bg-accent transition-colors shadow-md"
          aria-label="Toggle Table of Contents"
        >
          <Menu id="toc-menu-icon" className="h-5 w-5" />
          <X id="toc-close-icon" className="h-5 w-5 hidden" />
        </button>

        <!-- Mobile TOC Overlay -->
        <div 
          id="toc-overlay" 
          class="lg:hidden fixed inset-0 z-40 bg-black/50 hidden backdrop-blur-sm"
        ></div>

        <!-- Mobile TOC Slide-in Panel -->
        <aside 
          id="mobile-toc-panel"
          class="lg:hidden fixed left-0 top-0 bottom-0 w-80 max-w-[85vw] bg-background z-40 transform -translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
        >
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-lg font-semibold">Contents</h2>
              <button 
                id="toc-close-btn"
                class="inline-flex items-center justify-center rounded-md p-1 hover:bg-accent transition-colors"
                aria-label="Close Table of Contents"
              >
                <X className="h-5 w-5" />
              </button>
            </div>
            <TableOfContents headings={headings} />
          </div>
        </aside>

        <!-- Desktop Fixed TOC -->
        <aside class="hidden lg:block fixed left-0 top-24 w-64 h-[calc(100vh-6rem)] bg-background overflow-y-auto z-30">
          <div class="p-4">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      </div>

    )}

    <!-- Shared Content Container -->
    <div class={headings.length > 3 ? "lg:ml-52 container" : "container"}>
      <div class="max-w-3xl mx-auto">

        <!-- Article Content -->
        <div class="code-block-wrapper">
          <article class="prose-technical dark:prose-invert">
            <Content />
          </article>
        </div>

        <!-- Footer Section -->
        <div class="mt-12 space-y-6">

          <!-- Tags -->
          {entry.data.tags && (
            <div class="flex gap-2 flex-wrap">
              {entry.data.tags.map((tag: string) => (
                <span class="inline-flex items-center px-3 py-1 bg-accent text-accent-foreground rounded-lg text-xs font-medium">
                  #{tag}
                </span>
              ))}
            </div>
          )}

          <!-- Author/date metadata -->
          <div class="text-sm text-muted-foreground">
            <p>By {entry.data.author} on {entry.data.pubDate.toLocaleDateString()}</p>
          </div>

          <!-- Navigation -->
          <div class="flex flex-col sm:flex-row justify-between gap-4 pt-8">
            <!-- Previous Post -->
            {previousEntry && (
              <a
                href={`/blog/${previousEntry.slug}`}
                class="flex items-center px-4 py-3 bg-accent hover:bg-accent/80 text-accent-foreground rounded-lg text-sm font-medium transition-colors"
              >
                <span class="mr-2">←</span>
                <div class="text-left">
                  <div class="text-xs opacity-75">Previous</div>
                  <div class="truncate max-w-[200px] sm:max-w-none">{previousEntry.data.title}</div>
                </div>
              </a>
            )}

            <!-- Next Post -->
            {nextEntry && (
              <a
                href={`/blog/${nextEntry.slug}`}
                class="flex items-center justify-end px-4 py-3 bg-accent hover:bg-accent/80 text-accent-foreground rounded-lg text-sm font-medium transition-colors"
              >
                <div class="text-right">
                  <div class="text-xs opacity-75">Next</div>
                  <div class="truncate max-w-[200px] sm:max-w-none">{nextEntry.data.title}</div>
                </div>
                <span class="ml-2">→</span>
              </a>
            )}
          </div>

        </div>

      </div>
    </div>

  </main>
</Layout>

<script>
  // Reading progress bar
  const progressBar = document.getElementById('reading-progress');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = (scrollTop / scrollHeight) * 100;
      progressBar.style.width = progress + '%';
    });
  }

  // Mobile TOC toggle functionality
  const tocToggle = document.getElementById('toc-toggle');
  const tocMenuIcon = document.getElementById('toc-menu-icon');
  const tocCloseIcon = document.getElementById('toc-close-icon');
  const tocOverlay = document.getElementById('toc-overlay');
  const tocPanel = document.getElementById('mobile-toc-panel');
  const tocCloseBtn = document.getElementById('toc-close-btn');

  function openMobileTOC() {
    if (!tocPanel || !tocOverlay || !tocMenuIcon || !tocCloseIcon) return;
    tocPanel.classList.remove('-translate-x-full');
    tocOverlay.classList.remove('hidden');
    tocMenuIcon.classList.add('hidden');
    tocCloseIcon.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileTOC() {
    if (!tocPanel || !tocOverlay || !tocMenuIcon || !tocCloseIcon) return;
    tocPanel.classList.add('-translate-x-full');
    tocOverlay.classList.add('hidden');
    tocMenuIcon.classList.remove('hidden');
    tocCloseIcon.classList.add('hidden');
    document.body.style.overflow = '';
  }

  if (tocToggle) {
    tocToggle.addEventListener('click', () => {
      if (tocPanel?.classList.contains('-translate-x-full')) {
        openMobileTOC();
      } else {
        closeMobileTOC();
      }
    });
  }

  if (tocCloseBtn) {
    tocCloseBtn.addEventListener('click', closeMobileTOC);
  }

  if (tocOverlay) {
    tocOverlay.addEventListener('click', closeMobileTOC);
  }

  // Close TOC on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMobileTOC();
    }
  });

  // Close TOC when clicking on a TOC link
  document.querySelectorAll('#mobile-toc-panel .toc-item').forEach(item => {
    item.addEventListener('click', closeMobileTOC);
  });
</script>
