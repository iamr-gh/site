---
interface Props {
  sticky?: boolean;
}

const { sticky = false } = Astro.props;
---
<header class={`p-3 md:p-4 border-b ${sticky ? 'sticky top-0 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 z-50' : ''}`}>
  <nav class="container flex justify-between items-center">
    <a href="/" class="text-xl font-light tracking-wide">iamr</a>
    
    <!-- Navigation - Unified for mobile and desktop -->
    <ul class="flex gap-4 font-light text-sm sm:text-base">
      <li><a href="/blog" class="hover:underline">Blog</a></li>
      <li><a href="/projects" class="hover:underline">Projects</a></li>
    </ul>
  </nav>
</header>


